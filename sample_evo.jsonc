{
    /*
    result from initial condition
    */
    "F_init": 520, // 計算初期推力 [N]
    "Pc_def": 2.0, //初期燃焼室圧力 [MPa]
    "OF_def": 6.5, //初期O/F比 [-]
    "mdot_new": 0.3166, // 初期推進剤流量 [kg/s]
    "Df_init": 0.034, // 初期燃料内径 [m]
    "eta_cstar": 0.8, // Cstar効率 [-]
    "eta_nozzle": 1.0, // nozzle効率 [-]
    "Kstar":  4.513866707266423e-06, // Kstar = Cd * A_orifice [m^2]
    "epsilon": 3.15, // 開口比 [-]
    "Lf": 0.36, // 燃料長さ [m]
    "Dt":  0.0173, // スロート径 [m]

    /*
    fuel oxidizer material constants
    */
    "rho_f": 1190, // 燃料密度 [kg/m^3]
    "a_ox": 0.000131, // 燃料後退速度定数 [?]
    "n_ox": 0.34, // 燃料後退速度指数 [-]
    "Pt_init": 4.2, // 初期タンク圧力 [MPa] 密度は補完計算する.

    /*
    time evolution constants
    */
    "Vol_ox": 0.002, // タンク容積 [m^3]
    "Pt_end": 2.3, //終了時タンク圧 [MPa]

    /*
    Fast debug
    調整段階で毎回回すとしんどいので一定回数ごとに回す簡易計算版の設定
    intで設定し，1だとノーマル(毎回回す)．2以上を設定すると剰余が0のiterationのみCEAをはじく
    実用上10とかでも耐えはする
    */
    "is_fast": 20
}